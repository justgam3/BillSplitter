# Backend API Configuration
# Copy this file to .env and update with your configuration

# For Physical Device Testing (replace with your computer's IP):
API_BASE_URL=http://YOUR_COMPUTER_IP:5000/api

# To find your IP:
# Windows: ipconfig | grep -i "ipv4"
# Mac/Linux: ifconfig | grep "inet "

# Example:
# API_BASE_URL=http://192.168.1.100:5000/api

# For Production:
# API_BASE_URL=https://api.billsplitter.com/api

# Important: Phone and computer must be on the same WiFi network!
